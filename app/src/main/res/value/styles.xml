<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme (Dark) -->
    <style name="Theme.BazarBan" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/background_dark</item>
        
        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/primary</item>
        <item name="android:navigationBarColor">@color/background_dark</item>
        
        <!-- آیکون نوار وضعیت سفید (ثابت) -->
        <item name="android:windowLightStatusBar">false</item>
        
        <!-- فونت پیش‌فرض -->
        <item name="android:fontFamily">@font/b_nazanin</item>
		
		<!-- راست چین -->
        <item name="android:layoutDirection">rtl</item>
        <item name="android:textDirection">rtl</item>
        <item name="android:textAlignment">viewStart</item>
    </style>

    <!-- Card Style -->
    <style name="CardStyle" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/surface_dark</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">4dp</item>
    </style>

    <!-- Button Style (Primary) -->
    <style name="ButtonPrimary" parent="Widget.Material3.Button">
        <item name="android:backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:fontFamily">@font/b_nazanin</item>
    </style>

    <!-- Button Style (VIP) -->
    <style name="ButtonVip" parent="Widget.Material3.Button">
        <item name="android:backgroundTint">@color/vip_gradient_start</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:fontFamily">@font/b_nazanin</item>
    </style>

    <!-- Text Style (Title) -->
    <style name="TextTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/b_nazanin</item>
    </style>

    <!-- Text Style (Subtitle) -->
    <style name="TextSubtitle" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">@font/b_nazanin</item>
    </style>

    <!-- Text Style (Price Up) -->
    <style name="TextPriceUp" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/up_green</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/b_nazanin</item>
    </style>

    <!-- Text Style (Price Down) -->
    <style name="TextPriceDown" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/down_red</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/b_nazanin</item>
    </style>

</resources>
